# Production environment for docker-compose.prod.yml.
#
# Usage:
#   cp .env.prod.example .env
#   # edit .env and replace every <CHANGE_ME> value
#   docker compose -f docker-compose.prod.yml up -d --build
#
# docker compose automatically loads ".env" from this directory. This file
# contains SECRETS - never commit the filled-in copy (.gitignore excludes .env).

# --- Required ---------------------------------------------------------------
# Public address Caddy should serve and get a certificate for.
#   A domain name -> automatic Let's Encrypt HTTPS.
#   "localhost"   -> local test cert (internal CA).
SITE_ADDRESS=<CHANGE_ME_YOUR_DOMAIN>
# Contact e-mail for ACME / Let's Encrypt (renewal notices).
ACME_EMAIL=<CHANGE_ME_YOU@EXAMPLE.COM>

# Exactly the public origin(s) of the app. Comma separated, include scheme.
CORS_ORIGINS=https://<CHANGE_ME_YOUR_DOMAIN>
# Hostnames the backend answers to (blocks Host-header attacks).
TRUSTED_HOSTS=<CHANGE_ME_YOUR_DOMAIN>

# Strong random bearer token that guards every /api route. It is injected by
# nginx server-side and never sent to the browser. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=<CHANGE_ME_STRONG_RANDOM_TOKEN>

# --- Optional ---------------------------------------------------------------
# Leave empty for same-origin "/api" (recommended). Set only if the API is
# served from a different origin, e.g. https://api.example.com/api
VITE_API_URL=

# Upper bound for uploaded files, in megabytes (must be >= your largest doc;
# nginx allows 30m by default).
MAX_UPLOAD_MB=25
# Reporter's max review document upload, characters of extracted text.
MAX_EXTRACTED_CHARS=5000000

LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Optional AI-assisted reasoning (leave off for deterministic mode) -------
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
