# NeuroSync backend - PRODUCTION environment template
# Copy to ".env" (or inject as real environment variables in your platform) and
# replace every <CHANGE_ME> value. NEVER commit the filled-in file: .gitignore
# excludes ".env".
#
# The application runs without an LLM key in deterministic demonstration mode.
# A secret API key is only required for optional AI-assisted reasoning.

# --- Required in production -------------------------------------------------
# Absolute path to the SQLite database on a PERSISTENT volume. Four slashes
# means an absolute filesystem path. Do NOT leave this CWD-relative in prod.
DATABASE_URL=sqlite:////app/data/neurosync.db
# Directory for uploaded files (persistent volume; same volume as the DB so a
# single snapshot captures everything).
UPLOAD_DIR=/app/data/uploads

# Exactly the public origin(s) of your frontend. Comma-separated, no wildcard,
# include scheme. If the frontend proxies /api on the same origin you may set
# this to that origin anyway (harmless, and required if a separate origin calls
# the API directly).
CORS_ORIGINS=https://<CHANGE_ME_YOUR_DOMAIN>
# Only enable credentials if you actually use cookies/auth on cross-origin
# requests. Must be false when CORS_ORIGINS contains "*".
CORS_ALLOW_CREDENTIALS=false

# Strong random bearer token guarding /api/*. Generate with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Injected server-side by the reverse proxy so it never reaches the browser.
# Leave empty ONLY if the backend is unreachable except on a private network.
API_TOKEN=<CHANGE_ME_STRONG_RANDOM_TOKEN>

# Hostnames your instance answers to (block Host-header attacks). Comma
# separated; include the public domain. Set to "*" to disable the check.
TRUSTED_HOSTS=<CHANGE_ME_YOUR_DOMAIN>

# --- Application / operations ----------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# "json" for log aggregators, "text" for plain files.
LOG_FORMAT=json
# Disable interactive API docs in production unless access is restricted.
ENABLE_DOCS=false

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_EXTRACTED_CHARS=5000000

# --- Scheduler weights (must sum to 1.0) ------------------------------------
WEIGHT_SEVERITY=0.30
WEIGHT_UNCERTAINTY=0.25
WEIGHT_EVIDENCE_GAP=0.25
WEIGHT_INFO_GAIN=0.20
DEFAULT_ITERATION_LIMIT=25
DEFAULT_MIN_EVIDENCE=1

# --- Optional AI-assisted reasoning (leave disabled for deterministic mode) --
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
