# NeuroSync environment configuration
# Copy this file to ".env" and fill in values as needed.
# The application runs fully in deterministic demonstration mode WITHOUT any of
# these optional settings. An API key is only required for optional LLM assistance.

# --- Optional LLM (OpenAI-compatible) integration ---
# Leave OPENAI_API_KEY empty to run in demonstration mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Base URL for OpenAI-compatible providers (e.g. a local server or proxy).
OPENAI_BASE_URL=https://api.openai.com/v1
# Request timeout in seconds and maximum retry attempts.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Enable/disable LLM assistance globally (feature is also toggleable per investigation).
ENABLE_LLM=false

# --- Application ---
# SQLite connection string used for local development.
DATABASE_URL=sqlite:///./neurosync.db
# Comma separated list of allowed CORS origins for local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow credentialed cross-origin requests. Ignored (forced off) if CORS_ORIGINS
# contains a "*" wildcard.
CORS_ALLOW_CREDENTIALS=true
# Shared bearer token required on every /api route when set. Leave empty for
# loopback-only local use. Required whenever the API is reachable off-host.
API_TOKEN=
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25
# Maximum extracted document text length in characters (zip-bomb guard).
MAX_EXTRACTED_CHARS=5000000
# Scheduler heuristic weights (must sum to 1.0 for a normalized 0-100 score).
WEIGHT_SEVERITY=0.30
WEIGHT_UNCERTAINTY=0.25
WEIGHT_EVIDENCE_GAP=0.25
WEIGHT_INFO_GAIN=0.20
# Default investigation iteration limit and minimum evidence threshold.
DEFAULT_ITERATION_LIMIT=25
DEFAULT_MIN_EVIDENCE=1

# --- Deployment / operations (all optional; defaults suit local development) ---
# "development" (default) or "production".
ENVIRONMENT=development
# Directory for uploaded files. Leave empty for backend/uploads; in production
# point this at a persistent volume (e.g. /app/data/uploads).
UPLOAD_DIR=
# Logging: level and format ("text" or "json").
LOG_LEVEL=INFO
LOG_FORMAT=text
# Serve interactive API docs at /docs, /redoc, /openapi.json. Disable in prod.
ENABLE_DOCS=true
# Comma-separated allowed hostnames (TrustedHostMiddleware). "*" disables the
# check; set explicit hosts in production.
TRUSTED_HOSTS=*
